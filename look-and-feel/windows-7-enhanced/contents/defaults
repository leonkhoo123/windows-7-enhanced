# Cursor theme is intentionally not set. Install an open cursor theme and
# uncomment the two lines below if you want one.
#[kcminputrc][Mouse]
#cursorTheme=

[kdeglobals][General]
ColorScheme=Windows7Enhanced

[kdeglobals][Icons]
Theme=windows-7-enhanced

[kdeglobals][KDE]
widgetStyle=kvantum

[ksplashrc][KSplash]
Engine=KSplashQML
Theme=windows-7-enhanced-splash

[kwinrc][DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][WindowSwitcher]
LayoutName=thumbnail_grid

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__windows-7-enhanced

[plasmarc][Theme]
name=windows-7-enhanced
