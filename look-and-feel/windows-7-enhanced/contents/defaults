# Cursor theme is intentionally not set: "Win7Bulid-cursors" (used by the
# original setup) has no clear open license. Install an open cursor theme and
# uncomment the two lines below if you want one.
#[kcminputrc][Mouse]
#cursorTheme=Win7Bulid-cursors

[kdeglobals][General]
ColorScheme=Windows7Enhanced

[kdeglobals][Icons]
Theme=windows-7-enhanced

[kdeglobals][KDE]
widgetStyle=kvantum

[kwinrc][DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][WindowSwitcher]
LayoutName=thumbnail_grid

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__exposeair

[plasmarc][Theme]
name=exposeair
